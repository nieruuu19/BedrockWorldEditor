<Window x:Class="BedrockWorldEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bedrock World Editor" Height="680" Width="1020"
        Background="#252A30" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Clean ScrollViewer-Backed ListBox & TreeView ControlTemplates with Proper Scrollbar Support -->
        <Style x:Key="UmeCleanListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Padding="0" Margin="0" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter Margin="0"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UmeCleanTreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <ScrollViewer x:Name="PART_ScrollViewer" Padding="0" Margin="0" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter Margin="0"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Button Style -->
        <Style x:Key="UmeNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E4752"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive NBT Toolbar Badge Button Style (Folded Document Icon Look) -->
        <Style x:Key="NbtBadgeButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BadgeHoverBorder"
                                CornerRadius="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Width="16" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Folded Document Page Shape -->
                                <Path Data="M 0.5,0.5 L 11.5,0.5 L 15.5,4.5 L 15.5,17.5 L 0.5,17.5 Z"
                                      Fill="#FFFFFF" Stroke="#8A949E" StrokeThickness="1"/>
                                <Path Data="M 11.5,0.5 L 11.5,4.5 L 15.5,4.5"
                                      Fill="#E4E7EB" Stroke="#8A949E" StrokeThickness="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1.5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BadgeHoverBorder" Property="Background" Value="#CBE4F9"/>
                                <Setter TargetName="BadgeHoverBorder" Property="BorderBrush" Value="#5B9BD5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BadgeHoverBorder" Property="Background" Value="#8CC3F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive NBT Toolbar Icon Button Style (For TT, List, Compound) -->
        <Style x:Key="NbtIconToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder"
                                CornerRadius="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#CBE4F9"/>
                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="#5B9BD5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#8CC3F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UME 22px ListBoxItem Style for Worlds & Players -->
        <Style x:Key="UmeListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Height="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E2E5E9"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#CBE4F9"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#8CC3F2"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="BorderThickness" Value="1"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#8CC3F2"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UME Chevron Expander Button (> / v) -->
        <Style x:Key="UmeTreeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="#01FFFFFF" Width="16" Height="16">
                            <Path x:Name="ExpandPath"
                                  Stroke="#4A5568"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 5,4 L 9,8 L 5,12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 4,6 L 8,10 L 12,6"/>
                                <Setter TargetName="ExpandPath" Property="Stroke" Value="#1F2933"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Stroke" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-Width 22px UME TreeViewItem Style -->
        <Style x:Key="UmeTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2933"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    Height="22"
                                    HorizontalAlignment="Stretch">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource UmeTreeToggleStyle}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition SourceName="RowBorder" Property="IsMouseOver" Value="True"/>
                                    <Condition Property="BorderThickness" Value="0"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="#E2E5E9"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition SourceName="RowBorder" Property="IsMouseOver" Value="True"/>
                                    <Condition Property="BorderThickness" Value="1"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="#8CC3F2"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP TAB BAR (UME STYLE) ==================== -->
        <Border Grid.Row="0" Background="#23272D" BorderBrush="#1A1D21" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Green Active World Tab -->
                <Border Grid.Column="0" Background="#2AB573" Padding="14,0" MinWidth="240">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <UniformGrid Rows="2" Columns="2" Width="13" Height="13" Margin="0,0,9,0">
                            <Rectangle Fill="White" Margin="0.8"/>
                            <Rectangle Fill="White" Margin="0.8"/>
                            <Rectangle Fill="White" Margin="0.8"/>
                            <Rectangle Fill="White" Margin="0.8"/>
                        </UniformGrid>
                        <TextBlock x:Name="TxtWorldTabTitle" Text="No World Selected" Foreground="White" 
                                   FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Account Selector in Header -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Account:" Foreground="#9AA5B1" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <Grid Width="230" Height="26" VerticalAlignment="Center">
                        <ComboBox x:Name="ComboAccounts"
                                  SelectionChanged="ComboAccounts_SelectionChanged"
                                  FontSize="12"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Text="Select an account..."
                                   Foreground="#616E7C"
                                   FontSize="12"
                                   Margin="8,0,24,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ComboAccounts}" Value="-1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#323942" BorderBrush="#23282E" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="155"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Save Icon + Active Target Indicator -->
                    <Border Grid.Row="0" Background="#3A424C" BorderBrush="#2B3139" BorderThickness="0,0,0,1" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSave" Grid.Column="0" Click="BtnSave_Click" IsEnabled="False"
                                    ToolTip="Save All World Changes (Ctrl+S)" Background="#2B3138" BorderBrush="#4C5663" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,6,0">
                                <TextBlock Text="💾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Border Grid.Column="1" Background="#282E35" BorderBrush="#454F5B" BorderThickness="1" CornerRadius="2" Padding="8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtActiveIcon" Text="📄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#CBD2D9"/>
                                    <TextBlock x:Name="TxtActiveFile" Text="" Foreground="#E4E7EB" 
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 1: Worlds List -->
                    <DockPanel Grid.Row="1" Margin="12,8,12,4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🌍" Foreground="#CBD2D9" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Worlds" Foreground="#E4E7EB" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border BorderBrush="#1E2328" BorderThickness="1" ClipToBounds="True">
                            <Border.Background>
                                <DrawingBrush Viewport="0,0,1,44" ViewportUnits="Absolute" TileMode="Tile">
                                    <DrawingBrush.Transform>
                                        <TranslateTransform x:Name="WorldStripeTransform" Y="0"/>
                                    </DrawingBrush.Transform>
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#FFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,22"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#F3F4F6">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,22,1,22"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                            <ListBox x:Name="WorldListBox"
                                     Style="{StaticResource UmeCleanListBoxStyle}"
                                     AlternationCount="2"
                                     ItemContainerStyle="{StaticResource UmeListBoxItemStyle}"
                                     SelectionChanged="WorldListBox_SelectionChanged"
                                     ScrollViewer.ScrollChanged="WorldListBox_ScrollChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="False"/>
                        </Border>
                    </DockPanel>

                    <!-- Row 2: Players List (With 8x8 Pixel-Accurate Steve Head Icon!) -->
                    <DockPanel Grid.Row="2" Margin="12,6,12,8">
                        <Button DockPanel.Dock="Top" Style="{StaticResource UmeNavButton}" Padding="0" Height="26" Margin="0,0,0,4"
                                Click="BtnTogglePlayersSection_Click" ToolTip="Click to expand/collapse Players list">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👤" Foreground="#CBD2D9" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Players" Foreground="#E4E7EB" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="PlayerListContainerBorder" BorderBrush="#1E2328" BorderThickness="1" ClipToBounds="True">
                            <Border.Background>
                                <DrawingBrush Viewport="0,0,1,44" ViewportUnits="Absolute" TileMode="Tile">
                                    <DrawingBrush.Transform>
                                        <TranslateTransform x:Name="PlayerStripeTransform" Y="0"/>
                                    </DrawingBrush.Transform>
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#FFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,22"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#F3F4F6">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,22,1,22"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                            <ListBox x:Name="PlayerListBox"
                                     Style="{StaticResource UmeCleanListBoxStyle}"
                                     AlternationCount="2"
                                     SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource UmeListBoxItemStyle}"
                                     SelectionChanged="PlayerListBox_SelectionChanged"
                                     ScrollViewer.ScrollChanged="PlayerListBox_ScrollChanged"
                                     PreviewMouseRightButtonDown="PlayerListBox_PreviewMouseRightButtonDown"
                                     KeyDown="PlayerListBox_KeyDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="False">
                                <ListBox.ContextMenu>
                                    <ContextMenu x:Name="PlayerContextMenu" Opened="PlayerContextMenu_Opened" Closed="PlayerContextMenu_Closed" Background="#F8F9FA" BorderBrush="#A0AAB4" FontSize="12.5">
                                        <MenuItem x:Name="MenuDeletePlayer" Header="Delete" InputGestureText="Del" Click="MenuDeletePlayer_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="❌" Foreground="#D64545" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Exact 8x8 Pixel-Accurate Steve Face from Reference Image -->
                                            <UniformGrid Rows="8" Columns="8" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                                <!-- Row 0 (Top Hair) -->
                                                <Rectangle Fill="#2E1F14"/>
                                                <Rectangle Fill="#2B1D12"/>
                                                <Rectangle Fill="#2F2015"/>
                                                <Rectangle Fill="#281B11"/>
                                                <Rectangle Fill="#24180F"/>
                                                <Rectangle Fill="#281B11"/>
                                                <Rectangle Fill="#2D1E13"/>
                                                <Rectangle Fill="#2A1C12"/>
                                                <!-- Row 1 (Lower Hair) -->
                                                <Rectangle Fill="#2A1C12"/>
                                                <Rectangle Fill="#2F2015"/>
                                                <Rectangle Fill="#2F2015"/>
                                                <Rectangle Fill="#332317"/>
                                                <Rectangle Fill="#422C1D"/>
                                                <Rectangle Fill="#3A271A"/>
                                                <Rectangle Fill="#2C1D13"/>
                                                <Rectangle Fill="#261910"/>
                                                <!-- Row 2 (Sideburns + Forehead) -->
                                                <Rectangle Fill="#2D1E13"/>
                                                <Rectangle Fill="#B6896C"/>
                                                <Rectangle Fill="#BD8E70"/>
                                                <Rectangle Fill="#C29375"/>
                                                <Rectangle Fill="#B88A6C"/>
                                                <Rectangle Fill="#BD8E70"/>
                                                <Rectangle Fill="#AC7E61"/>
                                                <Rectangle Fill="#342317"/>
                                                <!-- Row 3 (Upper Forehead / Brow) -->
                                                <Rectangle Fill="#AA7D60"/>
                                                <Rectangle Fill="#B58668"/>
                                                <Rectangle Fill="#B7886A"/>
                                                <Rectangle Fill="#B28466"/>
                                                <Rectangle Fill="#AD8063"/>
                                                <Rectangle Fill="#B68769"/>
                                                <Rectangle Fill="#A5775B"/>
                                                <Rectangle Fill="#9C7055"/>
                                                <!-- Row 4 (Eyes: White Sclera + #23199B Blue Pupils + Nose Bridge) -->
                                                <Rectangle Fill="#B48668"/>
                                                <Rectangle Fill="#FFFFFF"/>
                                                <Rectangle Fill="#23199B"/>
                                                <Rectangle Fill="#B58668"/>
                                                <Rectangle Fill="#BB8C6E"/>
                                                <Rectangle Fill="#23199B"/>
                                                <Rectangle Fill="#FFFFFF"/>
                                                <Rectangle Fill="#AA7D60"/>
                                                <!-- Row 5 (Cheeks + Darker Nose Tip) -->
                                                <Rectangle Fill="#9C6F54"/>
                                                <Rectangle Fill="#B38366"/>
                                                <Rectangle Fill="#B7896C"/>
                                                <Rectangle Fill="#6A4030"/>
                                                <Rectangle Fill="#653D2E"/>
                                                <Rectangle Fill="#B88A6C"/>
                                                <Rectangle Fill="#A27458"/>
                                                <Rectangle Fill="#8E634A"/>
                                                <!-- Row 6 (Cheeks + Upper Beard/Mouth) -->
                                                <Rectangle Fill="#906349"/>
                                                <Rectangle Fill="#96674C"/>
                                                <Rectangle Fill="#46221A"/>
                                                <Rectangle Fill="#84493A"/>
                                                <Rectangle Fill="#84493A"/>
                                                <Rectangle Fill="#46221A"/>
                                                <Rectangle Fill="#8F6147"/>
                                                <Rectangle Fill="#80553E"/>
                                                <!-- Row 7 (Chin + Lower Beard) -->
                                                <Rectangle Fill="#81553D"/>
                                                <Rectangle Fill="#7D523B"/>
                                                <Rectangle Fill="#442119"/>
                                                <Rectangle Fill="#411F17"/>
                                                <Rectangle Fill="#442119"/>
                                                <Rectangle Fill="#47231B"/>
                                                <Rectangle Fill="#83573E"/>
                                                <Rectangle Fill="#7A5039"/>
                                            </UniformGrid>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="#111111"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- Row 3: World Settings (level.dat) & Quick Actions -->
                    <StackPanel Grid.Row="3" Margin="0,2,0,6">
                        <Separator Background="#262C33" Margin="0,0,0,4"/>
                        <Button x:Name="BtnLevelDat" Style="{StaticResource UmeNavButton}" Click="BtnLevelDat_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="15" Width="26" VerticalAlignment="Center" Foreground="#9AA5B1"/>
                                <TextBlock Text="World Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnOpenFolder" Style="{StaticResource UmeNavButton}" Click="BtnOpenFolder_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="#9AA5B1"/>
                                <TextBlock Text="Open World Folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Row 4: UME Bottom Blue Action Button -->
                    <Button x:Name="BtnSaveBottom" Grid.Row="4" Click="BtnSave_Click" IsEnabled="False"
                            Background="#1967B2" Foreground="White" FontWeight="SemiBold" FontSize="14"
                            BorderThickness="0" Cursor="Hand" Content="Save World">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#1E78CE"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#2A435E"/>
                                                    <Setter Property="Foreground" Value="#7B8FA3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== RIGHT NBT EDITOR AREA ==================== -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- Row 0: UME Light Gray NBT Toolbar (With Folded Document Badges, Serif TT, 3-Dot List & 3D Compound!) -->
                <Border Grid.Row="0" Background="#EAECEF" BorderBrush="#D0D5DC" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="Byte" Click="BtnAddTag_Click" ToolTip="Add Byte Tag">
                                <TextBlock Text="B" Foreground="#D64545" FontWeight="Bold" FontSize="9.5"/>
                            </Button>
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="Short" Click="BtnAddTag_Click" ToolTip="Add Short Tag">
                                <TextBlock Text="S" Foreground="#27AE60" FontWeight="Bold" FontSize="9.5"/>
                            </Button>
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="Int" Click="BtnAddTag_Click" ToolTip="Add Int Tag">
                                <TextBlock Text="I" Foreground="#2980B9" FontWeight="Bold" FontSize="9.5"/>
                            </Button>
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="Long" Click="BtnAddTag_Click" ToolTip="Add Long Tag">
                                <TextBlock Text="L" Foreground="#8E44AD" FontWeight="Bold" FontSize="9.5"/>
                            </Button>
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="Float" Click="BtnAddTag_Click" ToolTip="Add Float Tag">
                                <TextBlock Text="F" Foreground="#9B59B6" FontWeight="Bold" FontSize="9.5"/>
                            </Button>
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="Double" Click="BtnAddTag_Click" ToolTip="Add Double Tag">
                                <TextBlock Text="D" Foreground="#16A085" FontWeight="Bold" FontSize="9.5"/>
                            </Button>
                            <!-- UME Red/Dark 01 ByteArray Button -->
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="ByteArray" Click="BtnAddTag_Click" ToolTip="Add ByteArray Tag (Opens Hex Editor)">
                                <TextBlock FontWeight="Bold" FontSize="8.5">
                                    <Run Text="0" Foreground="#D64545"/><Run Text="1" Foreground="#222831"/>
                                </TextBlock>
                            </Button>
                            <!-- UME Blue/Dark 01 IntArray Button -->
                            <Button Style="{StaticResource NbtBadgeButton}" Tag="IntArray" Click="BtnAddTag_Click" ToolTip="Add IntArray Tag (Opens Hex Editor)">
                                <TextBlock FontWeight="Bold" FontSize="8.5">
                                    <Run Text="0" Foreground="#2980B9"/><Run Text="1" Foreground="#222831"/>
                                </TextBlock>
                            </Button>
                            <!-- UME Serif T + Smaller T String Button -->
                            <Button Style="{StaticResource NbtIconToolbarButton}" Tag="String" Click="BtnAddTag_Click" ToolTip="Add String Tag">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="T" FontFamily="Georgia" FontWeight="Bold" FontSize="13.5" Foreground="#3E4C59" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="T" FontFamily="Georgia" FontWeight="Bold" FontSize="9.5" Foreground="#3E4C59" VerticalAlignment="Bottom" Margin="0.5,0,0,0.5"/>
                                </StackPanel>
                            </Button>
                            <!-- UME 3-Bullet + 3-Bar List Button -->
                            <Button Style="{StaticResource NbtIconToolbarButton}" Tag="List" Click="BtnAddTag_Click" ToolTip="Add List Tag">
                                <Canvas Width="14" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Rectangle Canvas.Left="0" Canvas.Top="1" Width="2" Height="2" Fill="#3E4C59"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="1" Width="10" Height="2" Fill="#3E4C59"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="5" Width="2" Height="2" Fill="#3E4C59"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="5" Width="10" Height="2" Fill="#3E4C59"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="9" Width="2" Height="2" Fill="#3E4C59"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="9" Width="10" Height="2" Fill="#3E4C59"/>
                                </Canvas>
                            </Button>
                            <!-- UME Cardboard Package Compound Button -->
                            <Button Style="{StaticResource NbtIconToolbarButton}" Tag="Compound" Click="BtnAddTag_Click" ToolTip="Add Compound Tag">
                                <Border Width="15" Height="15" CornerRadius="2" Background="#D49B5E" BorderBrush="#8C5C2C" BorderThickness="1">
                                    <Rectangle Width="4" Height="6" Fill="#F5E2C4" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                </Border>
                            </Button>
                        </StackPanel>

                        <!-- Search / Filter Box -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#BCCCDC" BorderThickness="1" CornerRadius="3" Height="28" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearch" Grid.Column="0" BorderThickness="0" VerticalContentAlignment="Center"
                                         Padding="6,0" FontSize="12" TextChanged="TxtSearch_TextChanged" Background="Transparent"/>
                                <TextBlock Grid.Column="0" Text="Filter tags..." Foreground="#9AA5B1" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="🔍" FontSize="12" Foreground="#7B8794" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Scroll-Synced Zebra Backdrop + Full-Height UME TreeView -->
                <Grid Grid.Row="1" ClipToBounds="True">
                    <Grid.Background>
                        <DrawingBrush Viewport="0,0,1,44" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Transform>
                                <TranslateTransform x:Name="NbtStripeTransform" Y="0"/>
                            </DrawingBrush.Transform>
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#FFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,1,22"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#F3F4F6">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,22,1,22"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>

                    <TreeView x:Name="NbtTreeView"
                              Style="{StaticResource UmeCleanTreeViewStyle}"
                              HorizontalContentAlignment="Stretch"
                              SelectedItemChanged="NbtTreeView_SelectedItemChanged"
                              TreeViewItem.Expanded="NbtTreeView_ItemExpandedOrCollapsed"
                              TreeViewItem.Collapsed="NbtTreeView_ItemExpandedOrCollapsed"
                              ScrollViewer.ScrollChanged="NbtTreeView_ScrollChanged"
                              PreviewMouseLeftButtonDown="NbtTreeView_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="NbtTreeView_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="NbtTreeView_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="NbtTreeView_PreviewMouseRightButtonDown"
                              ItemContainerStyle="{StaticResource UmeTreeViewItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              VirtualizingStackPanel.IsVirtualizing="False">
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="NbtContextMenu" Opened="NbtContextMenu_Opened" Closed="NbtContextMenu_Closed" Background="#F8F9FA" BorderBrush="#A0AAB4" FontSize="12.5">
                                <MenuItem x:Name="MenuUndo" Header="Undo" InputGestureText="Ctrl+Z" Click="MenuUndo_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="↩" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator x:Name="MenuUndoSeparator"/>
                                <MenuItem x:Name="MenuRename" Header="Rename" InputGestureText="F2" Click="MenuRename_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✏" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuEditValue" Header="Edit Value" InputGestureText="Double-Click" Click="MenuEditValue_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📝" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator x:Name="MenuRenameSeparator"/>
                                <MenuItem x:Name="MenuCut" Header="Cut" InputGestureText="Ctrl+X" Click="MenuCut_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✂" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuCopy" Header="Copy" InputGestureText="Ctrl+C" Click="MenuCopy_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuPaste" Header="Paste" InputGestureText="Ctrl+V" Click="MenuPaste_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuSelectAll" Header="Select All" InputGestureText="Ctrl+A" Click="MenuSelectAll_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="☑" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuDelete" Header="Delete" InputGestureText="Del" Click="MenuDelete_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="❌" Foreground="#D64545" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator x:Name="MenuMoveSeparator"/>
                                <MenuItem x:Name="MenuMoveUp" Header="Move Up" Click="MenuMoveUp_Click">
                                    <MenuItem.Icon>
                                        <Path Data="M 2,9 L 7,4 L 12,9" Stroke="#52606D" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MenuMoveDown" Header="Move Down" Click="MenuMoveDown_Click">
                                    <MenuItem.Icon>
                                        <Path Data="M 2,4 L 7,9 L 12,4" Stroke="#52606D" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>

                <!-- Row 2: Hidden Legacy Edit Bar (Collapsed so NBT Tree gets full UME height!) -->
                <Border Grid.Row="2" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="TxtSelectedTagName"/>
                        <TextBox x:Name="TxtEditValue" KeyDown="TxtEditValue_KeyDown"/>
                        <Button x:Name="BtnApply" Click="BtnApply_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2" Background="#EAECEF" BorderBrush="#D0D5DC" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusLeft" Grid.Column="0" Text="Ready" Foreground="#52606D" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusPath" Grid.Column="1" Text="" Foreground="#1F2933" FontSize="11.5" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>